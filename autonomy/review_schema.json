{
  "type": "object",
  "additionalProperties": false,
  "required": ["review_complete", "verdict", "reviewed_sha", "summary", "findings"],
  "properties": {
    "review_complete": {"type": "boolean"},
    "verdict": {"type": "string", "enum": ["PASS", "REMEDIATION_REQUIRED"]},
    "reviewed_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "summary", "required_fix"],
        "properties": {
          "severity": {"type": "string", "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]},
          "file": {"type": "string"},
          "line": {"type": ["integer", "null"]},
          "summary": {"type": "string"},
          "required_fix": {"type": "string"}
        }
      }
    }
  }
}
